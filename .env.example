# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/jobpilot_ai

# ─── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Adzuna Job API ──────────────────────────────────────────────────────────
# Register at https://developer.adzuna.com/ to get free API credentials.
# Leave empty to use the built-in mock job source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=id

# ─── Gmail OAuth (Phase 6) ───────────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
# Leave empty — email sending is disabled until credentials are configured.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secure-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── File Storage ────────────────────────────────────────────────────────────
CV_OUTPUT_DIR=generated_cvs
